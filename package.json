{
  "name": "@soffits/dsh-message-context",
  "version": "0.3.0",
  "description": "Tell the model who sent each message, where, when and what it replies to, and show messages agents sent as theirs in the Web UI. One format for Telegram, Matrix, the Web UI and agent-to-agent messages.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "check": "for f in index.js client.js src/*.js test/*.js; do node --check \"$f\" || exit 1; done"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "multi-user",
    "chat",
    "telegram",
    "matrix",
    "context"
  ],
  "author": "Sakina",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soffits/dsh-message-context.git"
  },
  "homepage": "https://github.com/soffits/dsh-message-context#readme",
  "bugs": {
    "url": "https://github.com/soffits/dsh-message-context/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
